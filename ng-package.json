{
  "$schema": "./node_modules/ng-packagr/ng-package.schema.json",
  "dest": "./dist",
  "assets": [
    {
      "glob": "**/*.scss",
      "input": "src/lib/theme",
      "output": "theme"
    }
  ],
  "lib": {
    "entryFile": "src/lib/public-api.ts",
    "styleIncludePaths": ["src/lib/theme"]
  }
}
