{
  "$schema": "./node_modules/ng-packagr/ng-package.schema.json",
  "dest": "./dist",
  "assets": [
    {
      "glob": "**/*.scss",
      "input": "src/theme",
      "output": "theme"
    },
    {
      "glob": "theme.scss",
      "input": "src",
      "output": ""
    }
  ],
  "lib": {
    "entryFile": "src/public-api.ts",
    "styleIncludePaths": ["src/theme"]
  }
}
