{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "outDir": "./dist/out-tsc/lib",
    "types": []
  },
  "angularCompilerOptions": {
    "skipTemplateCodegen": true,
    "compilationMode": "partial"
  },
  "include": ["src/lib/**/*.ts"],
  "exclude": ["src/lib/**/*.spec.ts", "**/*.stories.ts"]
}
