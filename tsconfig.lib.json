// Library build TypeScript configuration for ng-packagr.
// AI Agent: used by `npm run build` via ng-package.json. Emits declarations + source maps.
// compilationMode "partial" is required for Angular libraries — consumers compile templates.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "outDir": "./dist/out-tsc/lib"
  },
  "angularCompilerOptions": {
    "skipTemplateCodegen": true,
    "compilationMode": "partial"
  },
  "include": ["src/lib/**/*.ts"],
  "exclude": ["src/lib/**/*.spec.ts"]
}
