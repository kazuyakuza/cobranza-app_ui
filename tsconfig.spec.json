// Jest test TypeScript configuration.
// AI Agent: used by jest-preset-angular when running `npm test`. CommonJS module for Jest compat.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2016",
    "outDir": "./dist/out-tsc/spec",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.spec.ts", "src/**/*.d.ts", "setup-jest.ts"]
}
